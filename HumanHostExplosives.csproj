<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HumanHostExplosives</AssemblyName>
    <RootNamespace>HumanHostExplosives</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Point this at your install, e.g.
         C:\Program Files (x86)\Steam\steamapps\common\Human Host -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Human Host</GameDir>
    <ManagedDir>$(GameDir)\Human Host_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Animancer backs the character animation layers (Play_Anim_UpLayer / _UpperBodyLayer). -->
    <Reference Include="Kybernetik.Animancer">
      <HintPath>$(ManagedDir)\Kybernetik.Animancer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MyStatics.Get_NoneRepeat_Random_Index - vanilla's non-repeating clip picker. -->
    <Reference Include="Static_Class">
      <HintPath>$(ManagedDir)\Static_Class.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- OnGUI for the in-game config-reload confirmation. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game-specific gameplay assemblies -->
    <Reference Include="UI">
      <HintPath>$(ManagedDir)\UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Item_Info">
      <HintPath>$(ManagedDir)\Item_Info.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(ManagedDir)\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(ManagedDir)\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Tooltip_Text / ToolTipInfo / Language_Mgr, for item tooltips -->
    <Reference Include="Language">
      <HintPath>$(ManagedDir)\Language.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Camera">
      <HintPath>$(ManagedDir)\Camera.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Tool_Interacter, for the WeaponPosData hand-offset fix (Equip_This_Tool overwrites the
         held model's transform from this data every equip, so the offset has to live here, not
         on any transform) -->
    <Reference Include="Hand_Tools">
      <HintPath>$(ManagedDir)\Hand_Tools.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- AoE damage: Creature_Mgr / C_Controller_Base / Char_Status / RagdollManager,
         Smash_Fallen_Manager (the game's own trap/fall damage pipeline), the creature
         layer mask, and WeaponHit_Set.HitInfo (a Minus_Char_HP parameter type). -->
    <Reference Include="Creature">
      <HintPath>$(ManagedDir)\Creature.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Build_System">
      <HintPath>$(ManagedDir)\Build_System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Global_Funcs">
      <HintPath>$(ManagedDir)\Global_Funcs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sound_FX">
      <HintPath>$(ManagedDir)\Sound_FX.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Drop the built DLL straight into the plugins folder -->
  <Target Name="DeployToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BepInExDir)\plugins\$(AssemblyName)"
          ContinueOnError="true" />
    <ItemGroup>
      <GrenadeAssets Include="$(MSBuildProjectDirectory)\Assets\Grenade\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(GrenadeAssets)"
          DestinationFolder="$(BepInExDir)\plugins\$(AssemblyName)\Grenade"
          ContinueOnError="true" />
    <!-- Throw animation AssetBundle (built from Unity 2022.3.62f3). Optional: if it is absent
         the mod logs once and throws instantly, so a missing bundle must not fail the build. -->
    <ItemGroup>
      <AnimAssets Include="$(MSBuildProjectDirectory)\Assets\Anim\**\*.*" />
      <NailbombAssets Include="$(MSBuildProjectDirectory)\Assets\Nailbomb\**\*.*" />
    </ItemGroup>
    <!-- Nailbomb art is optional - the item is gated off in config until it exists. -->
    <Copy SourceFiles="@(NailbombAssets)"
          DestinationFolder="$(BepInExDir)\plugins\$(AssemblyName)\Nailbomb"
          ContinueOnError="true" />
    <Copy SourceFiles="@(AnimAssets)"
          DestinationFolder="$(BepInExDir)\plugins\$(AssemblyName)\Assets\Anim"
          ContinueOnError="true" />
  </Target>

</Project>
